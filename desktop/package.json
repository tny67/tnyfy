{
  "name": "tnyfy",
  "version": "1.0.0",
  "description": "Tnyfy - AI-Powered E-Commerce Automation Platform",
  "main": "main.js",
  "author": "tny67",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.tnyfy.app",
    "productName": "Tnyfy",
    "copyright": "Copyright © 2026 tny67",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../frontend/.next/standalone",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/public",
        "to": "frontend/public",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/.next/static",
        "to": "frontend/.next/static",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!__pycache__/**", "!.venv/**", "!*.pyc"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tnyfy"
    }
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}
